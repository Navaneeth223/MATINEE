{
  "name": "@matinee/subtitle-pipeline",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"import('fs').then(fs => fs.rmSync('dist', {recursive: true, force: true}))\""
  },
  "dependencies": {
    "@matinee/subtitle-core": "workspace:*",
    "@matinee/protocol": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "^24.1.0"
  }
}
